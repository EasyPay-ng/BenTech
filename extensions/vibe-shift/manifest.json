{
  "manifest_version": 3,
  "name": "Vibe Shift \u2014 reskin the web",
  "version": "1.0.0",
  "description": "Inject CSS and JS to reskin sites: Wikipedia as a green-screen terminal, X/Twitter as a dreamy vaporwave page.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.wikipedia.org/*",
    "https://*.twitter.com/*",
    "https://*.x.com/*"
  ],
  "action": {
    "default_title": "Vibe Shift",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.wikipedia.org/*",
        "https://*.twitter.com/*",
        "https://*.x.com/*"
      ],
      "js": [
        "src/themes.js",
        "src/apply.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "themes/*.css"
      ],
      "matches": [
        "https://*.wikipedia.org/*",
        "https://*.twitter.com/*",
        "https://*.x.com/*"
      ]
    }
  ]
}
